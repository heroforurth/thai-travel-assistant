# Copy to .env and put your course LiteLLM key in it. Never commit .env.
# OpenAI() reads OPENAI_BASE_URL and OPENAI_API_KEY from the environment.
OPENAI_BASE_URL=https://llm.nat-d.uk/v1
OPENAI_API_KEY=sk-replace-me

CHAT_MODEL=gemma-4-E4B-it
EMBED_MODEL=bge-m3

# Retrieval knobs (defaults chosen by eval/eval_retrieval.py, see README)
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVER=hybrid
TOP_K=5
MIN_SCORE=0.45
MAX_STEPS=5
